[{"id":"i-totally-agree","en":"I totally agree","fr":"je suis tout à fait d'accord","ex":"I totally agree with you.","lv":"A2"},{"id":"fair","en":"fair","fr":"juste, équitable","ex":"That's not fair!","lv":"A2"},{"id":"the-problem-is-that","en":"the problem is that","fr":"le problème, c'est que","ex":"The problem is that we have no time.","lv":"A2"},{"id":"to-be-against","en":"to be against","fr":"être contre","ex":"I'm against the idea.","lv":"A2"},{"id":"i-see-your-point-but","en":"I see your point, but…","fr":"je comprends, mais…","ex":"I see your point, but I disagree.","lv":"B1"},{"id":"i-m-not-convinced","en":"I'm not convinced","fr":"je ne suis pas convaincu","ex":"I'm not convinced it will work.","lv":"B1"},{"id":"according-to","en":"according to","fr":"selon, d'après","ex":"According to the news, it'll rain.","lv":"B1"},{"id":"advantage","en":"advantage","fr":"l'avantage","ex":"The main advantage is the price.","lv":"B1"},{"id":"debate","en":"debate","fr":"le débat","ex":"There's a big debate about it.","lv":"B1"},{"id":"disadvantage","en":"disadvantage","fr":"l'inconvénient","ex":"It has some disadvantages.","lv":"B1"},{"id":"evidence","en":"evidence","fr":"les preuves","ex":"There's no evidence.","lv":"B1"},{"id":"generally-speaking","en":"generally speaking","fr":"de manière générale","ex":"Generally speaking, people are kind.","lv":"B1"},{"id":"in-my-view","en":"in my view","fr":"à mon avis","ex":"In my view, it's a mistake.","lv":"B1"},{"id":"it-seems-to-me-that","en":"it seems to me that","fr":"il me semble que","ex":"It seems to me that we're wasting time.","lv":"B1"},{"id":"on-the-one-hand","en":"on the one hand","fr":"d'un côté","ex":"On the one hand, it's cheap…","lv":"B1"},{"id":"point-of-view","en":"point of view","fr":"le point de vue","ex":"From my point of view, it's unfair.","lv":"B1"},{"id":"pros-and-cons","en":"pros and cons","fr":"le pour et le contre","ex":"Let's weigh up the pros and cons.","lv":"B1"},{"id":"reasonable","en":"reasonable","fr":"raisonnable","ex":"That sounds reasonable.","lv":"B1"},{"id":"that-s-a-good-point","en":"that's a good point","fr":"c'est juste, bonne remarque","ex":"That's a good point.","lv":"B1"},{"id":"the-main-reason-is","en":"the main reason is","fr":"la raison principale est","ex":"The main reason is the cost.","lv":"B1"},{"id":"to-admit","en":"to admit","fr":"admettre, avouer","ex":"I admit I was wrong.","lv":"B1"},{"id":"to-argue","en":"to argue","fr":"se disputer ; soutenir (que)","ex":"Some people argue that it's too late.","lv":"B1"},{"id":"to-be-in-favour-of","en":"to be in favour of","fr":"être pour, être favorable à","ex":"I'm in favour of the plan.","lv":"B1"},{"id":"to-convince","en":"to convince","fr":"convaincre","ex":"You've convinced me.","lv":"B1"},{"id":"to-doubt","en":"to doubt","fr":"douter","ex":"I doubt it.","lv":"B1"},{"id":"to-persuade","en":"to persuade","fr":"persuader","ex":"She persuaded me to come.","lv":"B1"},{"id":"unfair","en":"unfair","fr":"injuste","ex":"It's so unfair.","lv":"B1"},{"id":"i-partly-agree","en":"I partly agree","fr":"je suis en partie d'accord","ex":"I partly agree, but not entirely.","lv":"B2"},{"id":"i-strongly-believe-that","en":"I strongly believe that","fr":"je suis convaincu que","ex":"I strongly believe that education is key.","lv":"B2"},{"id":"i-m-convinced-that","en":"I'm convinced that","fr":"je suis persuadé que","ex":"I'm convinced that he's lying.","lv":"B2"},{"id":"as-a-matter-of-fact","en":"as a matter of fact","fr":"en fait, à vrai dire","ex":"As a matter of fact, I was there.","lv":"B2"},{"id":"biased","en":"biased","fr":"partial, de parti pris","ex":"The article is very biased.","lv":"B2"},{"id":"controversial","en":"controversial","fr":"controversé","ex":"It's a controversial topic.","lv":"B2"},{"id":"drawback","en":"drawback","fr":"l'inconvénient","ex":"The only drawback is the noise.","lv":"B2"},{"id":"it-s-worth-considering","en":"it's worth considering","fr":"ça vaut la peine d'y réfléchir","ex":"It's worth considering.","lv":"B2"},{"id":"let-s-face-it","en":"let's face it","fr":"soyons honnêtes, regardons les choses en face","ex":"Let's face it, we made a mistake.","lv":"B2"},{"id":"that-s-not-the-point","en":"that's not the point","fr":"là n'est pas la question","ex":"That's not the point!","lv":"B2"},{"id":"there-s-no-doubt-that","en":"there's no doubt that","fr":"il ne fait aucun doute que","ex":"There's no doubt that it's dangerous.","lv":"B2"},{"id":"to-assume","en":"to assume","fr":"supposer, présumer","ex":"I assume you're coming.","lv":"B2"},{"id":"to-deny","en":"to deny","fr":"nier","ex":"He denied everything.","lv":"B2"},{"id":"to-make-a-point","en":"to make a point","fr":"faire valoir un argument","ex":"You've made your point.","lv":"B2"},{"id":"to-raise-a-question","en":"to raise a question","fr":"soulever une question","ex":"This raises an important question.","lv":"B2"},{"id":"whereas-i-think","en":"whereas I think","fr":"alors que je pense","ex":"He wants to stay, whereas I think we should leave.","lv":"B2"},{"id":"on-balance","en":"on balance","fr":"tout bien pesé","ex":"On balance, it was a good decision.","lv":"C1"},{"id":"to-some-extent","en":"to some extent","fr":"dans une certaine mesure","ex":"To some extent, you're right.","lv":"C1"}]