iantly.","lv":"C1"},{"id":"to-reserve-judgment","en":"to reserve judgment","fr":"mettre en délibéré","ex":"The judges reserved judgment.","lv":"C1"},{"id":"to-take-the-oath","en":"to take the oath","fr":"prêter serment","ex":"Witnesses take the oath before testifying.","lv":"C1"},{"id":"under-oath","en":"under oath","fr":"sous serment","ex":"He lied under oath.","lv":"C1"}]